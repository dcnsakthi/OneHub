          "name": "64b5e59f_f41f_4287_8ba9_1a4f1e858166",
          "properties": {
            "annotations": [],
            "type": "DataWarehouse",
            "typeProperties": {
              "endpoint": "@pipeline().parameters.data_product_context.Warehouse_Endpoint",
              "artifactId": "@pipeline().parameters.data_product_context.Warehouse_ID",
              "workspaceId": "@pipeline().parameters.data_product_context.Workspace_ID"
            }
          }
        },
        "typeProperties": {
          "scripts": [
            {
              "parameters": [
                {
                  "name": "table_id",
                  "type": "Int32",
                  "value": {
                    "value": "@pipeline().parameters.table_id",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ],
              "type": "Query",
              "text": {
                "value": "EXEC [dbo].[Pivot_Primary_Config] @table_id = @table_id",
                "type": "Expression"
              }
            },
            {
              "parameters": [
                {
                  "name": "table_id",
                  "type": "Int32",
                  "value": {
                    "value": "@pipeline().parameters.table_id",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ],
              "type": "Query",
              "text": {
                "value": "EXEC [dbo].[Get_Advanced_Metadata] @table_id = @table_id",
                "type": "Expression"
              }
            },
            {
              "type": "Query",
              "text": {
                "value": "SELECT  *\nFROM    dbo.Data_Pipeline_Metadata_Orchestration\nWHERE   Table_ID = @{pipeline().parameters.table_id}\nAND     Trigger_Name = '@{pipeline().parameters.trigger_name}'",
                "type": "Expression"
              }
            },
            {
              "parameters": [
                {
                  "name": "datastore_name",
                  "type": "String",
                  "value": {
                    "value": "@pipeline().parameters.source_datastore_name",
                    "type": "Expression"
                  },
                  "direction": "Input"
                }
              ],
              "type": "Query",
              "text": {
                "value": "EXEC [dbo].[Get_Datastore_Details] @datastore_name = @datastore_name",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        }
