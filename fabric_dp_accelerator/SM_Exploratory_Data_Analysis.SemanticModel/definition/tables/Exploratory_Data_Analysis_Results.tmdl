			SUMX(
			   SUMMARIZE(
			       Exploratory_Data_Analysis_Results, 
			       Exploratory_Data_Analysis_Results[Table ID],
			       "NullPercent", CALCULATE(
			            SUM(Exploratory_Data_Analysis_Results[Null Count])/SUM(Exploratory_Data_Analysis_Results[Total Rows]),
			            Filter(Exploratory_Data_Analysis_Results, Exploratory_Data_Analysis_Results[Data Profile Execution Time] = CALCULATE(MAX(Exploratory_Data_Analysis_Results[Data Profile Execution Time])))
