	measure 'Total Rows After Last Refesh' =
			CALCULATE(
			   MAX(Exploratory_Data_Analysis_Results[Total Rows]),
			   FILTER(
			       Exploratory_Data_Analysis_Results,
			       Exploratory_Data_Analysis_Results[Data Profile Execution Time] =
			       CALCULATE(MAX(Exploratory_Data_Analysis_Results[Data Profile Execution Time]), ALLEXCEPT(Exploratory_Data_Analysis_Results, Exploratory_Data_Analysis_Results[Table ID]))
